# ==============================================================================
# NovaTunnel VPN - Client Configuration Example
# File: client.toml
# ==============================================================================

[client]
# Public IPv4 or DNS hostname of your NovaTunnel VPN server.
server_host = "vpn.example.com"

# UDP port where NovaTunnel server is listening.
server_port = 51820

# The server's 32-byte X25519 public key (hexadecimal).
# Provided by your server administrator or generated by dashboard.
server_public_key = "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

# Client's private key (64 hex characters).
# Keep this secret!
private_key = "<GENERATE_YOUR_OWN_PRIVATE_KEY>"

# Client's public key (64 hex characters) registered on the server.
public_key = "aaaabbbbccccddddeeeeffff0000111122223333444455556666777788889999"

# Desired or assigned virtual VPN IP.
# If empty, the server will allocate the next free IP in the pool.
assigned_ip = "10.8.0.2"

# Name of the local virtual TUN network interface to create.
tun_name = "nova-client"

# Maximum Transmission Unit (MTU).
mtu = 1420

# Interval (in seconds) to send UDP keepalive packets.
# Keeps NAT mappings alive across routers and firewalls.
keepalive_interval = 25

# If true, redirect all Internet traffic through the encrypted VPN tunnel.
# If false, only route the VPN subnet (10.8.0.0/24) through the tunnel.
route_all_traffic = true

# DNS resolvers to use while connected to the VPN.
dns = ["1.1.1.1", "8.8.8.8"]
