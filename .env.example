# ==============================================================================
# NovaTunnel VPN - Environment Configuration Variables
# Copy to .env and customize for your deployment
# ==============================================================================

# Server Network Settings
NOVATUNNEL_HOST=0.0.0.0
NOVATUNNEL_PORT=51820
NOVATUNNEL_SUBNET=10.8.0.0/24
NOVATUNNEL_SERVER_VPN_IP=10.8.0.1
NOVATUNNEL_PEERS_FILE=/etc/novatunnel/peers.json

# Optional Static Server Keys (leave blank to generate at startup)
NOVATUNNEL_PRIVATE_KEY=
NOVATUNNEL_PUBLIC_KEY=

# Web Management Dashboard Settings
NOVATUNNEL_DASHBOARD_ENABLED=true
NOVATUNNEL_DASHBOARD_HOST=0.0.0.0
NOVATUNNEL_DASHBOARD_PORT=8080
NOVATUNNEL_DASHBOARD_SECRET=generate-a-strong-random-hex-string-for-session-signing
NOVATUNNEL_DASHBOARD_USER=admin
NOVATUNNEL_DASHBOARD_PASS=change-this-password-in-production
