[Unit]
Description=NovaTunnel VPN Server Daemon
Documentation=https://github.com/novatunnel/novatunnel-vpn
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/novatunnel-server start --config /etc/novatunnel/server.toml
Restart=always
RestartSec=5s
KillMode=process

# Linux Capabilities required for TUN device creation, raw packets, and low port binding
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=false

# Security sandboxing
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

# High file descriptor limit for concurrent UDP sockets
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
